{
    "name": "onpayio/php-sdk",
    "type": "library",
    "description": "PHP SDK for OnPay.io API",
    "homepage": "https://github.com/onpayio/php-sdk",
    "license": "MIT",
    "autoload": {
        "psr-4": {
            "OnPay\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "require": {
        "php": ">=8.2",
        "ext-json": "*",
        "psr/http-client": "^1.0",
        "psr/http-factory": "^1.0",
        "psr/http-message": "^1.1 || ^2.0",
        "php-http/discovery": "^1.19",
        "psr/log": "^1.0.2 || ^2.0 || ^3.0",
        "league/oauth2-client": "^2.9"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.5",
        "vimeo/psalm": "~6.17.0"
    },
    "suggest": {
        "guzzlehttp/guzzle": "A PSR-18 client + PSR-17 factories the SDK will auto-discover.",
        "nyholm/psr7": "A lightweight PSR-7/PSR-17 implementation to pair with a custom PSR-18 client."
    },
    "config": {
        "allow-plugins": {
            "php-http/discovery": true
        }
    }
}
